<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting (ASP.NET Core Module V2, in-process). Requires the .NET 10 Hosting Bundle and the
  IIS "WebSocket Protocol" feature (SignalR). Secrets such as ConnectionStrings__Bekp are NOT set here:
  configure them on the server with appcmd (stored in applicationHost.config) – see README.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- No environmentVariables here: ASP.NET Core defaults to Production, and every setting
           (ConnectionStrings__Bekp, Authentication__*) lives in applicationHost.config on the server,
           so redeploying this file never overwrites configuration and no duplicate keys can occur. -->
      <aspNetCore processPath="dotnet" arguments=".\BEKP.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <webSocket enabled="true" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="1048576" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>

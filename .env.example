# Copy to .env and replace every placeholder. Never commit .env.
# Local SQL Server container (docker compose --profile local-db up). Use a strong password.
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_Passw0rd!

# Separate "BEKP" database. For the shared hospital SQL Server use a dedicated, least-privilege login.
BEKP_CONNECTION_STRING=Server=sqlserver,1433;Database=BEKP;User Id=sa;Password=CHANGE_ME_Strong_Passw0rd!;TrustServerCertificate=true;Encrypt=true

# Development = local developer identity + synthetic data + simulator. Use Production for real deployments.
BEKP_ENVIRONMENT=Development
BEKP_AUTH_AUTHORITY=
BEKP_AUTH_AUDIENCE=
BEKP_APPLY_MIGRATIONS=true
BEKP_SEED_SYNTHETIC_DATA=true
BEKP_SIMULATION=true
